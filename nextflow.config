params.homeDir = System.getProperty('user.home')
params.workDir = System.getenv('NXF_WORK') ?: "${params.homeDir}/.nextflow/work"
params.condaCacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${params.workDir}/conda"

workDir = params.workDir

conda {
    enabled  = true
    useMamba = true
    cacheDir = params.condaCacheDir
    createTimeout = '2h'
}

// The launcher derives this from the YAML resource budget. Unlike process
// `cpus`, queueSize constrains how many tasks the executor may run at once.
executor {
    queueSize = (System.getenv('BASIN_MAX_CONCURRENT_TASKS') ?: '1') as int
}

manifest {
    name = 'hallamlab/BASINS'
    description = 'Biochemical Analysis Suite for Investigating Niche Spaces'
    homePage = 'https://github.com/hallamlab/BASINS'
}
